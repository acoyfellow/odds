{
  "name": "odds",
  "version": "0.0.1",
  "private": true,
  "description": "Ask for odds, not prose. Clef decision models in Pi through your Cloudflare AI Gateway.",
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "git submodule update --init --quiet tools/anti-slop && biome check . && oxlint",
    "test": "bun test ./test",
    "verify": "bun run check && bun run lint && bun run test",
    "prove:pi": "bun scripts/prove-pi.ts",
    "site:build": "cd site && bun build.ts",
    "site:deploy": "cd site && bun build.ts && wrangler deploy",
    "prove:auth": "bun scripts/prove-auth.ts",
    "prove:docs": "bun scripts/prove-docs.ts",
    "eval": "bun evals/run.ts",
    "eval:report": "bun evals/report.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@oxlint/plugins": "1.86.0",
    "@tailwindcss/cli": "^4",
    "@types/bun": "^1.3.14",
    "esbuild-svelte": "^0.9.5",
    "hono": "^4.12.19",
    "hyparquet": "^1.31.2",
    "oxlint": "1.86.0",
    "shiki": "^4.5.0",
    "svelte": "^5.45.0",
    "svelte-hono": "0.1.2",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4"
  }
}
